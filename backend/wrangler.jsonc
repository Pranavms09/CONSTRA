{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constra-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "constra-b561b",
    "GEMINI_MODEL": "gemini-flash-latest",
    // Comma-separated exact origins allowed by CORS (no "*").
    "FRONTEND_ORIGINS": "https://constra.pranavms09.workers.dev,http://localhost:5173,http://127.0.0.1:5173",
    // "true" enables demo-<role> bearer tokens and /auth/demo-login. Set "false" for a real deployment.
    "DEMO_MODE": "true",
    "OCR_MODE": "real",
    "MAX_UPLOAD_MB": "10",
    "SHOW_CHAIN_COPY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "constra-db",
      // Replace with the id printed by `npx wrangler d1 create constra-db`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "constra-files" }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "VERIFY_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
