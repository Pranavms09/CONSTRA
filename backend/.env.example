# Database
DATABASE_URL=sqlite:///./siteverify.db

# Authentication & Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=constra-b561b
FRONTEND_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=your_auditor_email@example.com

# AI Vision & Language Models (Store private keys locally in .env, never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Store & Verification Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
OCR_MODE=real            # real | fake
TESSERACT_CMD=           # path if not on PATH (optional)

# Cloudinary CDN for Evidence Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blockchain Anchoring Settings
CHAIN_MODE=fake          # fake | real
RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
EXPLORER_ADDRESS_URL=https://sepolia.etherscan.io/address/
ANCHOR_BATCH_SIZE=20
ANCHOR_BATCH_INTERVAL_SEC=20
ANCHOR_MAX_RETRIES=5
SHOW_CHAIN_COPY=false
