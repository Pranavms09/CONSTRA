{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constra-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "constra-b561b",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "FRONTEND_ORIGINS": "https://constra.pranavms09.workers.dev,http://localhost:5173,http://127.0.0.1:5173",
    "DEMO_MODE": "true",
    "OCR_MODE": "real",
    "MAX_UPLOAD_MB": "10",
    "SHOW_CHAIN_COPY": "false",
    "CHAIN_MODE": "mst",
    "MST_NETWORK": "mainnet",
    "MST_CHAIN_ID": "4646",
    "MST_RPC_URL": "https://mariorpc.mstblockchain.com",
    "MST_EXPLORER_URL": "https://mstscan.com",
    "CONTRACT_ADDRESS": "0x9945391814a414c3cbcc0DDCBe98919Ab75c3F54",
    "ACCESS_REGISTRY_ADDRESS": "0x9b8d7e21f44DeCB92415F3644C0A0Ce831d63BF5",
    "ACCESS_REGISTRY_FROM_BLOCK": "21731226"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "constra-db",
      "database_id": "3f34d73b-18ef-4bd0-abc1-006a247ef568",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "constra-files"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "VERIFY_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
