# Copy to .dev.vars for `wrangler dev`. Production: `npx wrangler secret put <NAME>`.
SECRET_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# MST relayer wallet (owner of EvidenceRegistry). Use a dedicated wallet funded from https://faucet.mstblockchain.com
ANCHOR_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Set CHAIN_MODE=fake to develop without a wallet (anchors are simulated).
# CHAIN_MODE=fake
# Local only: fixed demo-<role> tokens. Production keeps DEMO_MODE=false (wrangler.json).
DEMO_MODE=true
