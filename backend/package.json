{
  "name": "constra-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply constra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply constra-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "viem": "^2.57.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
