{
  "name": "constra-monorepo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "dev": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev --prefix backend",
    "deploy:api": "npm run db:migrate:remote --prefix backend && npm run deploy --prefix backend",
    "deploy:web": "npm run build && wrangler deploy -c wrangler.json",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "deploy:testnet": "npm run deploy:testnet --prefix contracts",
    "deploy:mainnet": "npm run deploy:mainnet --prefix contracts",
    "deploy:access:testnet": "npm run deploy:access:testnet --prefix contracts",
    "deploy:access:mainnet": "npm run deploy:access:mainnet --prefix contracts",
    "verify:mainnet": "npm run verify:mainnet --prefix contracts --"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  },
  "optionalDependencies": {
    "@oxlint/binding-linux-x64-gnu": "^1.87.0",
    "@oxlint/binding-linux-x64-musl": "^1.87.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.13",
    "@rolldown/binding-linux-x64-musl": "^1.2.13"
  }
}
